{
  "name": "air-water-model-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/acceptance.mjs",
    "test:environments": "node scripts/environment-acceptance.mjs",
    "test:marine": "node scripts/marine-acceptance.mjs",
    "test:qingzhou": "node scripts/qingzhou-acceptance.mjs",
    "test:library": "node scripts/library-acceptance.mjs",
    "test:hornsea": "node scripts/hornsea-acceptance.mjs",
    "test:ninepin": "node scripts/ninepin-acceptance.mjs",
    "test:usv-sites": "node scripts/usv-sites-acceptance.mjs",
    "test:algorithms": "node scripts/algorithms-acceptance.mjs",
    "test:missions": "node scripts/missions-acceptance.mjs",
    "test:dynamics": "node scripts/dynamics-acceptance.mjs",
    "test:ui": "node scripts/ui-acceptance.mjs",
    "data:usv-sites": "python scripts/extract-usv-sites.py && tsx scripts/export-usv-scenarios.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "tsx": "^4.20.6",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0"
  }
}
